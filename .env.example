# Copie este arquivo para .env apenas para testar localmente.
# No Render, cadastre estas variáveis em Environment.
MC_HOST=ENDERECO_DO_SEU_SERVIDOR
MC_PORT=25565
MC_USERNAME=NomeDoBot
# Opcional: por exemplo, 1.21.4. Deixe vazio para autodetectar.
MC_VERSION=
# Use microsoft para autenticação de conta Microsoft; offline somente
# em servidores próprios configurados para aceitar jogadores offline.
MC_AUTH=microsoft
